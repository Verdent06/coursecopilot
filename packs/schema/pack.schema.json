{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Verdent06/coursecopilot/packs/schema/pack.schema.json",
  "title": "CourseCopilot pack manifest",
  "description": "Shareable course pack: links, metadata, and a lecture→topic map. Never embed copyrighted course content.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "id", "name", "version", "sources"],
  "properties": {
    "schema": {
      "const": 1,
      "description": "Pack schema version"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9](?:[a-z0-9._-]{0,62}[a-z0-9])?$",
      "description": "Unique slug; must match the filename stem (e.g. mit-6.045-s11.json)"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "institution": {
      "type": "string",
      "maxLength": 200
    },
    "term": {
      "type": "string",
      "maxLength": 80
    },
    "license_note": {
      "type": "string",
      "maxLength": 4000,
      "description": "License of the linked materials. This pack itself is links only."
    },
    "maintainers": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 80
      }
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "description": "Manifest semver"
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "maxItems": 500,
      "items": { "$ref": "#/$defs/source" }
    },
    "topics": {
      "type": "array",
      "maxItems": 500,
      "description": "Lecture → topic map",
      "items": { "$ref": "#/$defs/topicEntry" }
    },
    "exams": {
      "type": "array",
      "maxItems": 20,
      "items": { "$ref": "#/$defs/exam" }
    },
    "connect_yourself": {
      "type": "array",
      "maxItems": 20,
      "description": "Placeholders for Canvas, lecture-capture, or local files that cannot be shared. The importer connects those themselves.",
      "items": { "$ref": "#/$defs/connectYourself" }
    }
  },
  "$defs": {
    "httpUrl": {
      "type": "string",
      "pattern": "^https?://",
      "maxLength": 2000
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "url"],
      "properties": {
        "kind": {
          "type": "string",
          "enum": ["website", "pdf", "youtube", "transcript"]
        },
        "url": { "$ref": "#/$defs/httpUrl" },
        "max_depth": { "type": "integer", "minimum": 0, "maximum": 10 },
        "max_pages": { "type": "integer", "minimum": 1, "maximum": 1000 },
        "include_prefix": { "type": "string", "maxLength": 500 },
        "lecture": { "type": "integer", "minimum": 0, "maximum": 999 },
        "as_slides": { "type": "boolean" },
        "title": { "type": "string", "maxLength": 300 }
      }
    },
    "topicEntry": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "lecture": { "type": "integer", "minimum": 0, "maximum": 999 },
        "title": { "type": "string", "maxLength": 300 },
        "topics": {
          "type": "array",
          "maxItems": 50,
          "items": { "type": "string", "minLength": 1, "maxLength": 200 }
        }
      }
    },
    "exam": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 200 },
        "topics": {
          "type": "array",
          "maxItems": 100,
          "items": { "type": "string", "minLength": 1, "maxLength": 200 }
        }
      }
    },
    "connectYourself": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "message"],
      "properties": {
        "kind": {
          "type": "string",
          "enum": ["canvas", "lecture_capture", "local_files"]
        },
        "message": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "host": { "type": "string", "maxLength": 200 }
      }
    }
  }
}
