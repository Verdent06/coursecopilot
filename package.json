{
  "name": "coursecopilot",
  "version": "0.1.0",
  "description": "NotebookLM for your actual classes, open source, inside the AI you already use.",
  "license": "MIT",
  "author": "Vedant Desai",
  "homepage": "https://github.com/Verdent06/coursecopilot#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Verdent06/coursecopilot.git"
  },
  "bugs": {
    "url": "https://github.com/Verdent06/coursecopilot/issues"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "education",
    "course",
    "claude",
    "chatgpt",
    "cursor"
  ],
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "main": "./dist/cli.js",
  "bin": {
    "coursecopilot": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc && node scripts/copy-sql.mjs",
    "start": "node dist/cli.js",
    "dev": "tsx src/cli.ts",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test": "vitest run",
    "check:no-llm": "node scripts/check-no-llm-sdks.mjs",
    "packs:index": "tsx scripts/generate-pack-index.ts",
    "packs:validate": "tsx scripts/validate-packs.ts",
    "packs:check-urls": "tsx scripts/check-pack-urls.ts"
  },
  "dependencies": {
    "@huggingface/transformers": "^3.8.1",
    "@modelcontextprotocol/node": "^2.1.1",
    "@modelcontextprotocol/server": "^2.3.1",
    "@mozilla/readability": "^0.6.0",
    "better-sqlite3": "12.9.0",
    "cheerio": "^1.2.0",
    "commander": "^14.0.0",
    "fast-xml-parser": "^5.11.2",
    "jszip": "^3.10.2",
    "linkedom": "^0.18.13",
    "p-limit": "^7.3.3",
    "robots-parser": "^3.0.1",
    "sqlite-vec": "^0.1.9",
    "turndown": "^7.2.4",
    "ulid": "^3.0.2",
    "unpdf": "^1.7.0",
    "yaml": "^2.9.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.2.5",
    "@modelcontextprotocol/client": "^2.3.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.18.8",
    "@types/turndown": "^5.0.6",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
